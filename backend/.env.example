# i-Core 백엔드 환경변수 설정 가이드

# App 설정
APP_NAME="강사 매칭 플랫폼 API"
SECRET_KEY="change_this_to_a_secure_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS 허용 오리진 (JSON 배열 형식)
CORS_ORIGINS=["http://localhost:8900", "http://localhost:3000", "http://127.0.0.1:8900"]

# 데이터베이스 설정 - 로컬 SQLite 기본값
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"
INSTRUCTOR_DATABASE_URL="sqlite+aiosqlite:///./data/private/내부_강사_정보.db"

# Cloud Run + Cloud SQL PostgreSQL 예시
# DATABASE_URL="postgresql+asyncpg://icore_service:<password>@/icore_app?host=/cloudsql/<project>:<region>:<instance>"
# INSTRUCTOR_DATABASE_URL="postgresql+asyncpg://icore_service:<password>@/icore_instructor?host=/cloudsql/<project>:<region>:<instance>"
# 운영 환경에서는 위 URL 전체를 각각 Secret Manager에 저장한 뒤 Cloud Run
# 환경변수 DATABASE_URL, INSTRUCTOR_DATABASE_URL으로 주입합니다.

# Google Gemini API Key (AI 에이전트 매칭 시 필요)
GEMINI_API_KEY="your_gemini_api_key_here"

# Google OAuth 설정
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_ALLOWED_DOMAIN="your_domain_here"
